<Page
    x:Class="WinGetStore.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="600">

            <!-- Header -->
            <TextBlock
                Text="About"
                FontSize="32"
                FontWeight="Bold"/>

            <!-- App Info Card -->
            <Grid
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    Glyph="&#xE74E;"
                    FontSize="48"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock
                        Text="WinGet Store"
                        FontSize="22"
                        FontWeight="Bold"/>
                    <TextBlock
                        Text="Version 1.0.0"
                        FontSize="14"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Description -->
            <TextBlock
                Text="A modern graphical interface for Windows Package Manager (WinGet). Browse, install, update, and uninstall packages through an intuitive user interface."
                TextWrapping="Wrap"
                FontSize="14"/>

            <!-- Info Cards -->
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Technology"
                    FontSize="20"
                    FontWeight="SemiBold"/>

                <Grid
                    Padding="16"
                    CornerRadius="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Built with" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text=".NET 8 + WinUI 3 + Windows App SDK" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <Grid
                    Padding="16"
                    CornerRadius="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Package Manager" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="Windows Package Manager (WinGet)" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Disclaimer -->
            <TextBlock
                Text="This application is NOT intended to replace WinGet. WinGet remains the package-management backend. This app provides a graphical interface for convenience."
                TextWrapping="Wrap"
                FontSize="13"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

        </StackPanel>
    </ScrollViewer>
</Page>
